# Copy this file to .env and fill in your own values:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
# Never commit .env — it is listed in .gitignore.

# --- Groq (required) ---------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional: chat model to use (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# --- LangSmith tracing (optional) --------------------------------------------
# Set LANGSMITH_TRACING=false to turn tracing off.
# Get a key at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=project-repository-rag
# Optional: only needed for a non-default region or self-hosted LangSmith
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# No embedding key is needed: all-MiniLM-L6-v2 runs locally with FastEmbed.
